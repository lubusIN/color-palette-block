{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blablablocks/color-palette-swatch",
	"title": "Swatch",
	"category": "design",
	"parent": [
		"blablablocks/color-palette"
	],
	"description": "A single swatch item inside the Color Palette block.",
	"attributes": {
		"color": {
			"type": "string",
			"default": "#000000"
		},
		"name": {
			"type": "string",
			"default": ""
		},
		"styles": {
			"type": "object",
			"default": {
				"card": {
					"backgroundColor": "",
					"borderColor": "",
					"borderWidth": "",
					"borderRadius": "",
					"padding": ""
				}
			}
		}
	},
	"providesContext": {
		"blablablocks/color-palette/swatchColor": "color"
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": false
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "color-palette-block"
}
