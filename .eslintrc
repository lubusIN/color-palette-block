{
	"extends": ["eslint:recommended", "plugin:react/recommended", "prettier"],
	"plugins": ["prettier", "react"],
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module",
		"ecmaFeatures": {
			"jsx": true
		}
	},
	"globals": {
		"wp": true,
		"document": true,
		"console": true,
		"window": true
	},
	"settings": {
		"react": {
			"pragma": "wp"
		}
	},
	"env": {
		"es6": true
	},
	"rules": {
		"prettier/prettier": "error",
		"react/prop-types": [0],
		"react/display-name": [0]
	}
}
